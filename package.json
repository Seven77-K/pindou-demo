{
  "name": "pindou_admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "backend": "npm start --prefix server",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run backend\" \"npm run serve\"",
    "build": "vue-cli-service build",
    "build:docker": "cross-env VUE_APP_ROUTER_MODE=history vue-cli-service build",
    "build:iis": "cross-env VUE_APP_ROUTER_MODE=hash vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "@meruem117/vue-seamless-scroll": "^0.1.8",
    "axios": "^1.9.0",
    "compression-webpack-plugin": "^11.1.0",
    "core-js": "^3.8.3",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "element-plus": "^2.9.10",
    "file-saver": "^2.0.5",
    "hls.js": "^1.6.16",
    "jszip": "^3.10.1",
    "pure-full-page": "^1.0.10",
    "sass-loader": "^13.3.2",
    "tesseract.js": "^5.1.1",
    "vue": "^3.2.13",
    "vue-router": "^4.5.1",
    "vue-seamless-scroll": "^1.1.23",
    "vuex": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "concurrently": "^9.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "sass": "^1.89.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/no-unused-components": 0,
      "no-unused-vars": 0,
      "no-self-assign": 0,
      "no-redeclare": 0,
      "no-mixed-spaces-and-tabs": 0,
      "vue/no-ref-as-operand": 0,
      "no-undef": 0,
      "vue/no-deprecated-slot-scope-attribute": 0,
      "vue/no-deprecated-slot-attribute": 0,
      "vue/no-deprecated-v-bind-sync": 0,
      "vue/valid-v-for": 0,
      "vue/multi-word-component-names": 0,
      "vue/require-v-for-key": 0,
      "vue/no-unused-vars": 0,
      "vue/no-use-v-if-with-v-for": 0,
      "vue/require-prop-type-constructor": 0,
      "no-dupe-keys": 0
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
